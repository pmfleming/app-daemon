{
  "protocol": "app-api",
  "version": 1,
  "operation_outcome": {
    "placement_statuses": ["pending", "placed", "unavailable", "failed"],
    "partial_success_example": {
      "id": "operation-example",
      "action": "launch",
      "target_id": "org.example.App.desktop",
      "status": "completed",
      "message": "Application started; workspace placement unavailable. Do not relaunch automatically.",
      "launch_backend": "uwsm-app",
      "launch_scope": "app-graphical.slice",
      "placement": {
        "workspace_id": "3",
        "status": "unavailable",
        "reason": "no unambiguous new window with verified launch ownership"
      }
    }
  },
  "registry": {
    "methods": [
      {
        "name": "applications.query",
        "params_example": {
          "query": "",
          "category": "",
          "generation": 1,
          "limit": 500
        },
        "response_key": "applications",
        "stream": "applications.changed"
      },
      {
        "name": "applications.revision",
        "params_example": {},
        "response_key": "revision",
        "stream": "applications.changed"
      },
      {
        "name": "applications.history",
        "params_example": {
          "target_id": "org.example.App.desktop",
          "since_ms": 0,
          "until_ms": 15000,
          "cursor": null,
          "limit": 1000
        },
        "response_key": "history",
        "stream": "applications.changed",
        "pagination": {
          "kind": "opaque-cursor",
          "request_field": "cursor",
          "response_field": "next_cursor",
          "order": "oldest-first",
          "summary_field": "summary",
          "summary_scope": "full-selected-window",
          "summary_weighting": "observed-duration",
          "summary_revision_field": "revision"
        }
      },
      {
        "name": "applications.energyOverview",
        "params_example": {
          "since_ms": 0,
          "limit": 20
        },
        "response_key": "energy_overview",
        "stream": "applications.changed"
      },
      {
        "name": "applications.refresh",
        "params_example": {
          "query": "",
          "category": "",
          "generation": 1,
          "limit": 500
        },
        "response_key": "applications",
        "stream": "applications.changed"
      },
      {
        "name": "applications.execute",
        "params_example": {
          "target_id": "org.example.App.desktop",
          "action": "activate",
          "window_id": null,
          "desktop_action_id": null,
          "expected_revision": 1,
          "workspace_id": "2"
        },
        "response_key": "operation",
        "stream": "applications.operation"
      },
      {
        "name": "applications.operation.status",
        "params_example": {
          "operation_id": "operation-example"
        },
        "response_key": "operation_status",
        "stream": "applications.operation"
      },
      {
        "name": "applications.settings.update",
        "params_example": {
          "target_id": "org.example.App.desktop",
          "category": "code"
        },
        "response_key": "settings",
        "stream": "applications.changed"
      }
    ],
    "streams": [
      {
        "name": "applications.changed"
      },
      {
        "name": "windows.changed"
      },
      {
        "name": "applications.operation"
      }
    ]
  }
}
